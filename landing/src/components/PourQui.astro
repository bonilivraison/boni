---
import Icon from './Icon.astro';
const cibles = [
  {
    id: 'client',
    icon: 'utilisateur',
    who: 'Particuliers & entreprises',
    title: 'Envoyez, recevez, commandez.',
    points: [
      'Le prix détaillé avant de confirmer',
      'Votre livreur suivi sur la carte',
      'Une notification à chaque étape',
      'Moto ou voiture, selon ce que vous envoyez',
    ],
    cta: "Rejoindre la liste d'attente",
    tone: 'laterite',
  },
  {
    id: 'partenaire',
    icon: 'boutique',
    who: 'Restaurants & commerces',
    title: 'Un canal simple pour vos commandes.',
    points: [
      'Acceptez ou refusez une commande en un geste',
      'Indiquez votre temps de préparation',
      'Un livreur passe quand la commande est prête',
      'Un relevé clair de vos ventes et paiements',
    ],
    cta: 'Devenir partenaire',
    tone: 'or',
  },
  {
    id: 'livreur',
    icon: 'casque',
    who: 'Livreurs à moto ou en voiture',
    title: 'Des missions près de vous.',
    points: [
      'Vous voyez ce que vous gagnez avant d\'accepter',
      'Vos gains suivis dans l\'application',
      'À moto ou en voiture',
      'Un profil vérifié, pour la confiance de tous',
    ],
    cta: 'Devenir livreur BoniLivraison',
    tone: 'vert',
  },
];
---

<section id="pour-qui" class="section who">
  <div class="container">
    <p class="eyebrow reveal">Pour qui</p>
    <h2 class="section-title reveal" style="--d:80ms">Une ville,<br />trois façons d'en être.</h2>

    <div class="who__grid">
      {
        cibles.map((c, i) => (
          <article class={`who__card who__card--${c.tone} reveal`} style={`--d:${i * 120}ms`}>
            <div class="who__top">
              <span class="who__icon">
                <Icon name={c.icon} size={30} />
              </span>
              <p class="who__who">{c.who}</p>
            </div>
            <h3>{c.title}</h3>
            <ul>
              {c.points.map((p) => (
                <li>
                  <Icon name="check" size={18} /> {p}
                </li>
              ))}
            </ul>
            <a href={`#inscription`} data-profil={c.id} class={`btn ${c.tone === 'laterite' ? '' : c.tone === 'or' ? 'btn--nuit' : 'btn--or'}`}>
              {c.cta} <Icon name="fleche" size={18} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .who__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: clamp(40px, 6vw, 72px);
    align-items: stretch;
  }
  .who__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(26px, 3vw, 40px);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--shadow-card);
    border-top: 10px solid var(--c);
  }
  .who__card:nth-child(2) {
    transform: translateY(28px);
  }
  .who__card--laterite {
    --c: var(--laterite);
  }
  .who__card--or {
    --c: var(--or);
  }
  .who__card--vert {
    --c: var(--vert);
  }
  .who__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .who__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--c);
    color: #fff;
  }
  .who__card--or .who__icon {
    color: var(--nuit);
  }
  .who__who {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .who__card h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
  }
  .who__card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    flex: 1;
  }
  .who__card li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    align-items: start;
    color: var(--ink-soft);
  }
  .who__card li :global(svg) {
    margin-top: 3px;
    color: var(--accent-2);
  }
  .who__card .btn {
    align-self: flex-start;
  }
  @media (max-width: 960px) {
    .who__grid {
      grid-template-columns: 1fr;
    }
    .who__card:nth-child(2) {
      transform: none;
    }
  }
</style>
