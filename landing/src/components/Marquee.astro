---
const words = ['Colis', 'Documents', 'Repas', 'Achats', 'Marchandises', 'À moto', 'En voiture', 'De A à B'];
---

<div class="marquee" aria-hidden="true">
  <div class="weave"></div>
  <div class="marquee__band">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <span class="marquee__group">
            {words.map((w) => (
              <>
                <span>{w}</span>
                <svg viewBox="0 0 20 20" width="20" height="20">
                  <path d="M10 1 19 10 10 19 1 10z" fill="currentColor" />
                </svg>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>
  <div class="weave"></div>
</div>

<style>
  .marquee {
    transform: rotate(-1.4deg);
    margin-block: -14px;
    position: relative;
    z-index: 2;
    width: 104%;
    margin-left: -2%;
  }
  .marquee__band {
    background: var(--nuit);
    color: var(--sable);
    overflow: hidden;
    padding-block: 16px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: defile 38s linear infinite;
  }
  .marquee__group {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 3.4vw, 2.4rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .marquee__group svg {
    color: var(--or);
    flex: none;
  }
  .marquee__group span:nth-of-type(3n + 2) {
    color: var(--or);
  }
  .marquee__group span:nth-of-type(3n) {
    -webkit-text-stroke: 1.5px var(--sable);
    color: transparent;
  }
  @keyframes defile {
    to {
      transform: translateX(-50%);
    }
  }
</style>
