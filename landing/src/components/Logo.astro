---
/**
 * Logo BoniLivraison.
 * Le monogramme est un « b » dessiné comme un trajet :
 * le point or en haut est le départ (A), le point au cœur de la boucle l'arrivée (B).
 */
interface Props {
  variant?: 'full' | 'mark';
  tone?: 'color' | 'light' | 'mono';
  size?: number;
  class?: string;
}
const { variant = 'full', tone = 'color', size = 40, class: cls = '' } = Astro.props;
const tile = tone === 'mono' ? 'currentColor' : 'var(--laterite)';
const stroke = tone === 'mono' ? 'var(--bg)' : 'var(--sable)';
const dot = tone === 'mono' ? 'var(--bg)' : 'var(--or)';
---

<span class:list={['logo', `logo--${tone}`, cls]} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
    <rect width="64" height="64" rx="18" fill={tile}></rect>
    <path d="M23 22v18" stroke={stroke} stroke-width="7" stroke-linecap="round"></path>
    <circle cx="34" cy="40" r="11" fill="none" stroke={stroke} stroke-width="7"></circle>
    <circle cx="23" cy="13" r="5.5" fill={dot}></circle>
    <circle cx="34" cy="40" r="3.4" fill={dot}></circle>
  </svg>
  {
    variant === 'full' && (
      <span class="logo__word">
        <span class="logo__boni">boni</span>
        <span class="logo__liv">livraison</span>
      </span>
    )
  }
  <span class="sr-only">BoniLivraison</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.26);
    text-decoration: none;
    color: var(--ink);
  }
  .logo__mark {
    flex: none;
  }
  .logo__word {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: calc(var(--logo-size) * 0.62);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .logo__boni {
    font-weight: 800;
  }
  .logo__liv {
    font-weight: 500;
    color: var(--accent);
  }
  .logo--light {
    color: var(--sable);
  }
  .logo--light .logo__liv {
    color: var(--or);
  }
  .logo--mono .logo__liv {
    color: inherit;
  }
</style>
