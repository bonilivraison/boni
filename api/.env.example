# Clever Cloud : ces variables se déclarent dans la console (voir le README racine).
# PORT et HOST sont fournis par la plateforme ; API_DOMAIN et Caddy ne servent qu'en auto-hébergement.

# Domaine public de l'API (enregistrement DNS A/AAAA pointant sur le serveur), ex. api.bonilivraison.com
API_DOMAIN=

# Origines autorisées à envoyer des inscriptions (le site GitHub Pages)
ALLOWED_ORIGINS=https://bonilivraison.github.io

# true derrière un reverse proxy de confiance (Clever Cloud, Caddy)
TRUST_PROXY=true

# --- E-mails (SMTP) ---
# Sans SMTP_HOST, les e-mails sont seulement journalisés.
# En local avec le profil dev : SMTP_HOST=mailpit, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 ; vide = déduit du port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BoniLivraison <no-reply@bonilivraison.example>"
# Destinataires des notifications, séparés par des virgules
MAIL_TO=contact@bonilivraison.example

# Limitation : nombre d'inscriptions par IP et par fenêtre (ms)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Dossier des CSV. Relatif = résolu depuis APP_HOME (Clever Cloud, où est monté le FS Bucket) ou le dossier courant.
DATA_DIR=data
